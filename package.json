{
  "name": "@said-protocol/client",
  "version": "0.21.0",
  "description": "SAID Protocol SDK — agent identity, trust scoring, enforcement, and cross-chain messaging on Solana",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "said": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js",
      "require": "./dist/middleware.cjs",
      "default": "./dist/middleware.js"
    },
    "./agent-card": {
      "types": "./dist/agent-card.d.ts",
      "import": "./dist/agent-card.js",
      "require": "./dist/agent-card.cjs",
      "default": "./dist/agent-card.js"
    },
    "./acp": {
      "types": "./dist/acp.d.ts",
      "import": "./dist/acp.js",
      "require": "./dist/acp.cjs",
      "default": "./dist/acp.js"
    },
    "./x402": {
      "types": "./dist/x402.d.ts",
      "import": "./dist/x402.js",
      "require": "./dist/x402.cjs",
      "default": "./dist/x402.js"
    },
    "./passport": {
      "types": "./dist/passport.d.ts",
      "import": "./dist/passport.js",
      "require": "./dist/passport.cjs",
      "default": "./dist/passport.js"
    },
    "./trust-oracle": {
      "types": "./dist/trust-oracle.d.ts",
      "import": "./dist/trust-oracle.js",
      "require": "./dist/trust-oracle.cjs",
      "default": "./dist/trust-oracle.js"
    },
    "./sati": {
      "types": "./dist/sati.d.ts",
      "import": "./dist/sati.js",
      "require": "./dist/sati.cjs",
      "default": "./dist/sati.js"
    },
    "./mcp-server": {
      "types": "./dist/mcp-server.d.ts",
      "import": "./dist/mcp-server.js",
      "require": "./dist/mcp-server.cjs",
      "default": "./dist/mcp-server.js"
    },
    "./enforcement-oracle": {
      "types": "./dist/enforcement-oracle.d.ts",
      "import": "./dist/enforcement-oracle.js",
      "require": "./dist/enforcement-oracle.cjs",
      "default": "./dist/enforcement-oracle.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "node test/integration.mjs",
    "test:cjs": "node test/cjs-import.test.cjs",
    "test:all": "npm run build && npm run test && npm run test:cjs && node test/acp.test.mjs && node test/x402.test.mjs && npx tsx --test src/test/passport.test.ts && npx tsx --test src/test/trust-oracle.test.ts && npx tsx --test src/test/sati.test.ts && npx tsx --test src/test/mcp-server.test.ts && npx tsx --test src/test/enforcement-oracle.test.ts",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "said",
    "x402",
    "agent",
    "cross-chain",
    "solana",
    "a2a",
    "erc-8004",
    "erc-8183",
    "acp",
    "sati",
    "sati-compatibility",
    "agent-commerce",
    "trust-score",
    "agent-identity",
    "kya",
    "reputation",
    "staking",
    "slashing",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "enforcement",
    "enforcement-oracle",
    "cjs",
    "esm",
    "dual-module"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SAID-Protocol/said-sdk"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.0",
    "@x402/fetch": "^2.5.0",
    "@x402/svm": "^2.5.0",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  },
  "peerDependencies": {
    "@solana/kit": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@solana/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
